
{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        { "slug": "base", "color": "#FFFFFF", "name": "White" },
        { "slug": "contrast", "color": "#111111", "name": "Dark Gray" },
        { "slug": "accent-1", "color": "#A855F7", "name": "Neon Purple" },
        { "slug": "accent-2", "color": "#503AA8", "name": "Deep Purple" },
        { "slug": "accent-3", "color": "#070709", "name": "Midnight Black" },
        { "slug": "accent-4", "color": "#686868", "name": "Gray" },
        { "slug": "accent-5", "color": "#FBFAF3", "name": "Off White" },
        { "slug": "accent-6", "color": "#292932", "name": "Charcoal" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Heading - Fira Code",
          "fontFamily": "'Fira Code', monospace"
        },
        {
          "slug": "body",
          "name": "Body - Manrope",
          "fontFamily": "Manrope, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.38rem", "name": "Large" },
        { "slug": "x-large", "size": "1.75rem", "name": "Extra Large" },
        { "slug": "xx-large", "size": "2.15rem", "name": "Extra Extra Large" }
      ]
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "20", "size": "10px", "name": "Tiny" },
        { "slug": "30", "size": "20px", "name": "X-Small" },
        { "slug": "40", "size": "30px", "name": "Small" },
        { "slug": "50", "size": "50px", "name": "Regular" },
        { "slug": "60", "size": "70px", "name": "Large" },
        { "slug": "70", "size": "90px", "name": "X-Large" },
        { "slug": "80", "size": "140px", "name": "XX-Large" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|accent-3",
      "text": "var:preset|color|base"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading"
        },
        "color": {
          "text": "var:preset|color|base"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|accent-1"
        }
      }
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": "var:preset|color|accent-1",
          "text": "var:preset|color|base"
        },
        "border": {
          "radius": "4px"
        }
      },
      "core/navigation": {
        "color": {
          "text": "var:preset|color|base"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "fontSize": "var:preset|font-size|medium"
        }
      }
    }
  }
}
